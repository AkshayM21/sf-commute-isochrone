[Unit]
Description=SF Commute Isochrone (RAPTOR map server)
After=network.target
Documentation=https://github.com/akshaymanglik/sf-commute-isochrone
# Crash-loop budget: cap fast restarts so a real alarm fires instead of consuming the box.
# (StartLimitIntervalSec/Burst must live in [Unit], not [Service] — systemd silently ignores
# them in [Service] and logs an "Unknown key name" warning on every restart.)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=sfci
Group=sfci
WorkingDirectory=/opt/sfci
EnvironmentFile=/etc/sfci.env
# Numba's @njit(cache=True) writes .nbc files next to the source by default. With our
# ProtectSystem=strict, /opt/sfci is read-only -> the cache silently fails to persist and we
# re-JIT (~10s for the parallel MC kernel) on every restart. Point it at a systemd-managed
# CacheDirectory so the warmup pays off across restarts.
Environment=NUMBA_CACHE_DIR=/var/cache/sfci/numba
# Flask is behind Caddy + Cloudflare -- tell _client_ip it can also fall back to X-Forwarded-For.
Environment=TRUST_PROXY=1
# Persistent geocoder cache: live in the systemd-managed CacheDirectory so ProtectSystem=strict
# (which makes /opt/sfci read-only) doesn't crash the boot-time DEFAULT_ADDRESS lookup.
Environment=DEST_CACHE_FILE=/var/cache/sfci/dest_cache.json
# Don't buffer print() output (so journalctl -f shows logs live).
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sfci/.venv/bin/python scripts/server.py

# Restart on any exit; the StartLimit{IntervalSec,Burst} pair in [Unit] above caps the loop.
Restart=always
RestartSec=10s

# Give the in-flight MC kernel (~0.5s) a moment to finish before SIGKILL.
TimeoutStopSec=15s

# Logs go to journal (journalctl -u sfci -f). Caddy logs separately.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sfci

# Hardening -- Flask only needs the repo + tmp + the numba cache writable.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/sfci/data /tmp
CacheDirectory=sfci
CacheDirectoryMode=0750
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

# Memory ceiling -- A1.Flex 1 OCPU / 6 GB. App warm RSS ~245 MB, peak ~500 MB during /variance
# bursts. 1 GB cap leaves 5+ GB for OS / Caddy / page cache. MemoryHigh applies soft pressure first.
MemoryMax=1G
MemoryHigh=800M
TasksMax=128

[Install]
WantedBy=multi-user.target
