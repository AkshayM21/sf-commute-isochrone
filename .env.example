# Copy this file to `.env` (which is gitignored) and set your workplace.
#
# Quote any value that contains spaces or commas (e.g. an address). The setup
# scripts read these keys without executing this file, so quotes are stripped.
#
# You also need a free 511.org API token for the current Muni + Caltrain feeds:
#   API511_TOKEN=your-token   # get one at https://511.org/open-data/token

# Option A — an address to geocode (cached after first lookup):
DEFAULT_ADDRESS="1 Ferry Building, San Francisco"

# Option B — explicit coordinates (skips geocoding; overrides DEFAULT_ADDRESS):
# DEST_LAT=37.7955
# DEST_LON=-122.3937
# DEST_LABEL="My Office"

# Geocoder for address search + autocomplete. Default "geoapify" (free key, best SF quality,
# license permits caching/display); falls back to keyless "photon" if no key, or "nominatim".
#   free key at https://www.geoapify.com — the Geocoding API key also covers autocomplete
GEOCODER=geoapify
# GEOAPIFY_KEY=your-geoapify-key

# Optional tuning for the live server (scripts/server.py):
# GRID_M=200            # grid resolution in meters (smaller = finer but slower)
# WINDOW_MIN=30         # departure-time window in minutes
# R5_MAX_MEMORY=1000M   # cap the JVM heap (~1.15 GB RSS, fits a 2 GB host); unset = 80% of RAM
# PORT=8000
