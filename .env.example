# Copy this file to `.env` (which is gitignored) and set your workplace.
# Option A — an address to geocode (cached after first lookup):
DEFAULT_ADDRESS=1 Ferry Building, San Francisco

# Option B — explicit coordinates (skips geocoding; overrides DEFAULT_ADDRESS):
# DEST_LAT=37.7955
# DEST_LON=-122.3937
# DEST_LABEL=My Office

# Optional tuning for the live server (scripts/server.py):
# GRID_M=250        # grid resolution in meters (smaller = finer but slower)
# WINDOW_MIN=30     # departure-time window in minutes
# PORT=8000
