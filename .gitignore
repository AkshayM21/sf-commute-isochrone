# data + r5py network cache (downloaded inputs are large and may carry
# address-derived scratch files; ignore the whole directory so nothing in it
# can ever be accidentally committed)
data/
.venv/
__pycache__/
*.pyc

# generated, address-specific outputs (personal — keep local)
out/
REPORT.md

# private config
.env
.dest_cache.json

# test artifacts
tests/e2e/screens/
tests/**/__pycache__/
tests/.nbcache_departafter/
.pytest_cache/

# precompute prototype build artifacts
prototypes/**/artifacts/
prototypes/**/*.npz
prototypes/**/*.pkl
prototypes/**/*.log
prototypes/**/__pycache__/

# agent worktrees / local Claude state
.claude/

# Cloudflare Origin CA key/cert/CSR stay local (mint via deploy/cf/mint.py); the helper
# SCRIPTS are tracked — they're part of the deploy runbook (CLAUDE.md / DEPLOY.md).
# NB: must be `deploy/cf/*` (glob), not `deploy/cf/` — a directory exclude stops git from
# descending, which would make the `!*.py` re-include a no-op.
deploy/cf/*
!deploy/cf/*.py

# Working session notes — personal/operator-specific, not for public consumption
Progress.md
Issues.md
REVIEW_REPORT.md

# local planning docs (next-session queue)
.plans/
